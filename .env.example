# --- Mode ---
# MOCK_MODE=true  -> offline demo: local ledger, no external Lightning calls (default)
# MOCK_MODE=false -> real mode: use LNbits wallets/invoices/payments
MOCK_MODE=true

# --- LNbits (required for MOCK_MODE=false) ---
# Base URL of your LNbits instance (include http/https)
LNBITS_URL=https://legend.lnbits.com
# Wallet/admin API key (X-Api-Key) with permission to manage payments/wallets as supported
LNBITS_ADMIN_KEY=your_admin_key_here
# Optional: user-level auth for wallet provisioning on LNbits versions that require it
LNBITS_USERNAME=
LNBITS_PASSWORD=
# Optional: funding wallet admin key to auto-pay "fund" invoices in real-mode demos
# If unset, "fund" will display a BOLT11 invoice to pay manually.
FAUCET_ADMIN_KEY=

# --- WhatsApp Cloud API (optional, only for /webhook integration) ---
WA_TOKEN=your_whatsapp_token
WA_VERIFY_TOKEN=tontine_verify_2026
WA_PHONE_NUMBER_ID=your_phone_number_id

# --- App settings ---
DATABASE=tontine.db
RATE_LIMIT_PER_MIN=20
XOF_PER_SAT=4.0
